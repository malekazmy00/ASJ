# Security
SECRET_KEY=change-this-to-secrets-token-urlsafe-64-in-production
ENVIRONMENT=production

# Database (Supabase PostgreSQL URL or leave empty for local SQLite)
DATABASE_URL=postgresql://postgres:your_password@db.xxxxxx.supabase.co:5432/postgres
DB_PATH=warehouse_system.db

# Optional: Redis for session storage
SESSION_TYPE=memory  # memory | redis | database
REDIS_URL=redis://localhost:6379/0

# Gemini API
GEMINI_API_KEY=your-api-key-here

# Logging
LOG_LEVEL=INFO